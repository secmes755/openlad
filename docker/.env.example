# OpenLAD container environment template (0.4.0).
#
# Copy to .env (next to docker-compose.yml) and adjust. NEVER commit .env.
#
#   cp docker/.env.example .env

# --- Admin bootstrap ---------------------------------------------------------
# Used ONLY on first startup when no admin user exists in the data volume.
# Changing it afterwards does NOT reset an existing admin password.
OPENLAD_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Model endpoints (OpenAI-compatible) -------------------------------------
# Local model service on this host (compose uses network_mode: host):
# keep 127.0.0.1. Cloud endpoints: use the public URL directly.
OPENLAD_LLM_URL=http://127.0.0.1:8080/v1
OPENLAD_EMB_URL=http://127.0.0.1:8081/v1

# Registered model names on your backend (match the serving engine).
OPENLAD_LLM_MODEL=qwen3.5-9b
OPENLAD_EMB_MODEL=qwen3-embedding-0.6b

# --- Optional ----------------------------------------------------------------
# Query concurrency policy; match your backend's parallel capacity.
# OPENLAD_QUERY_CONCURRENCY_MODE=serial
# OPENLAD_QUERY_MAX_CONCURRENT=1
