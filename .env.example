# =============================================================================
# OpenLAD 环境配置模板（开源示例）
# =============================================================================
# 复制此文件为 .env 并填入你的实际路径后运行：
#   cp .env.example .env
# .env 不会被提交到 Git，其中可保存密码等敏感信息。
#
# 注意：路径请使用绝对路径；相对路径可能因启动目录不同而失效。

# ── 模型路径 ──
LLM_MODEL_PATH=/path/to/models/Qwen3.5-9B-GGUF/Qwen3.5-9B-Q5_K_M.gguf
LLM_MMPROJ_PATH=/path/to/models/Qwen3.5-9B-GGUF/mmproj-F16.gguf
EMB_MODEL_PATH=/path/to/models/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf

# ── LLM 参数 ──
OPENLAD_LLM_MODEL=qwen3.5-9b
LLM_CTX_SIZE=262144
LLM_PARALLEL=2
LLM_BATCH_SIZE=2048

# ── Embedding 参数 ──
OPENLAD_EMB_MODEL=qwen3-embedding
EMB_CTX_SIZE=8192
EMB_BATCH_SIZE=2048
EMB_UBATCH_SIZE=8192

# ── llama-server 路径 ──
LLAMA_SERVER=/path/to/llama.cpp/build/bin/llama-server

# ── OpenLAD API 配置 ──
OPENLAD_HOST=0.0.0.0
OPENLAD_PORT=11296
OPENLAD_LLM_URL=http://127.0.0.1:8080/v1
OPENLAD_EMB_URL=http://127.0.0.1:8081/v1
OPENLAD_DATA_DIR=/path/to/OpenLAD/data

# ── 并发控制 (匹配 llama-server --parallel 值) ──
# WARNING: 必须与 llama-server 的 --parallel 参数一致
#   参考硬件: <your GPU and model>
#   llama-server --parallel 2 --ctx-size 262144
#   如果更换模型/硬件，请相应调整
OPENLAD_LLM_NP=2
OPENLAD_INGEST_MAX_WORKERS=2
OPENLAD_CHART_VLM_MAX_WORKERS=2

# ── 初始管理员密码 ──
# 必填。首次启动时若不存在 admin 用户，将使用此密码创建。
# 请设置强密码，避免使用默认值。
# OPENLAD_ADMIN_PASSWORD=your-strong-password-here
