# =============================================================================
# OpenLAD configuration template (source install)
# =============================================================================
# Copy to .env and adjust. NEVER commit .env — it can hold secrets.
#   cp .env.example .env
#
# start.sh sources .env automatically; anything left unset falls back to a
# built-in default. Full variable reference:
#   docs/configuration.md  (中文: docs/zh-CN/configuration.md)

# --- Admin bootstrap (REQUIRED on first startup) ------------------------------
# Used ONLY when no admin user exists yet; changing it afterwards does NOT
# reset an existing admin password.
OPENLAD_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Model backends (OpenAI-compatible endpoints) ------------------------------
# Point these at your llama-server / Ollama / vLLM services.
# Model names must match the aliases registered on the backend.
# Query model: a 30B-class MoE (about 3B active parameters) fits a 16 GB card
# and decodes at the speed of a small model. Qwen3.6-35B-A3B at Q2_K_XL is the
# reference choice. Smaller models drive the query planner poorly: they loop on
# document listing and never reach the page content.
OPENLAD_LLM_URL=http://127.0.0.1:8080/v1
OPENLAD_LLM_MODEL=qwen3.6-35b-a3b
OPENLAD_EMB_URL=http://127.0.0.1:8081/v1
OPENLAD_EMB_MODEL=qwen3-embedding-0.6b
# Read timeout per request, in seconds (default 120). A working call finishes in
# tens of seconds; a longer ceiling only makes a stalled request hold its worker
# longer before the retry handler takes over.
# OPENLAD_LLM_TIMEOUT=120
# OPENLAD_EMB_TIMEOUT=120

# --- Optional: dedicated OCR endpoint (scanned / image-only pages) -------------
# OPENLAD_OCR_URL=http://127.0.0.1:8082/v1
# OPENLAD_OCR_MODEL=ovisocr2

# --- Optional: concurrency — match your LLM server's --parallel ----------------
# Safe defaults are 1. If you run llama-server --parallel 2, set all three to 2.
# OPENLAD_LLM_NP=2
# OPENLAD_INGEST_MAX_WORKERS=2
# OPENLAD_CHART_VLM_MAX_WORKERS=2

# --- Optional: embedding batch pairing -----------------------------------------
# Must equal the embedding server's --batch-size (default 2048 on both sides).
# Mismatch silently skips oversized chunks during ingestion ("hollow" docs).
# OPENLAD_EMB_MAX_INPUT_TOKENS=2048
